FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY server.js ./

ENV PORT=8090
EXPOSE 8090

HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD wget -q -O- http://localhost:8090/health || exit 1

CMD ["node", "server.js"]
