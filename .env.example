# Copy this file to .env and fill in local values. Never commit .env or any
# real credentials/tokens — this file only contains placeholders.
#
# Production (NODE_ENV=production) does not use the localhost defaults below.
# APP_ORIGIN, NEXT_PUBLIC_GTM_TAGGING_ORIGIN, and
# NEXT_PUBLIC_RUDDERSTACK_DATAPLANE_URL must be exact https origins or the
# server refuses to start. Production CSP omits mock destinations, GTM
# Preview, and Tag Assistant. First-party cookies are Secure on https.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
APP_ORIGIN=http://localhost:3000

# --- Postgres (shared by RudderStack state + the app warehouse schema) --
POSTGRES_USER=cpp_local
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cpp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RudderStack OSS (data-plane only; static workspaceConfig.json) -----
# Must match a writeKey declared in compose/rudderstack/workspaceConfig.json.
RUDDERSTACK_WRITE_KEY=LOCAL_DEV_WRITE_KEY_PLACEHOLDER
NEXT_PUBLIC_RUDDERSTACK_DATAPLANE_URL=http://localhost:8082

# --- GTM server-side (tagging + preview roles) --------------------------
# Leave this empty unless you opt in (`npm run stack:up:gtm` or the
# "With GTM" Dev Container). The value is the opaque Container Config
# string from GTM → your server container → "Manually provision tagging
# server". It is a credential, not a file — never commit a real value.
# The checked-in container-export.json files are not this value.
GTM_CONTAINER_CONFIG=
NEXT_PUBLIC_GTM_TAGGING_ORIGIN=http://localhost:8080
NEXT_PUBLIC_GTM_PREVIEW_ORIGIN=http://localhost:8081

# --- Mock destinations ----------------------------------------------------
NEXT_PUBLIC_MOCK_DESTINATIONS_ORIGIN=http://localhost:8090
