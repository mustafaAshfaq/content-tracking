            "type": "string",
            "format": "uri"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "home",
              "article",
              "category",
              "admin",
              "other"
            ]
          },
          "route_id": {
            "type": "string",
            "minLength": 1
